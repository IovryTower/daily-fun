---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FunFeed from '../../../components/FunFeed.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection } from 'astro:content';

const categoryLabels: Record<string, string> = {
  meme: '梗图',
  joke: '笑话',
  quote: '趣句',
  gif: '动图',
  image: '趣图',
  other: '其他',
};

export async function getStaticPaths({ paginate }) {
  const allFun = await getCollection('fun');
  const categories = [...new Set(allFun.map(item => item.data.category))];

  return categories.flatMap(cat => {
    const items = allFun
      .filter(item => item.data.category === cat)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    return paginate(items, {
      params: { category: cat },
      pageSize: 6,
    });
  });
}

const { category } = Astro.params;
const { page } = Astro.props;
const label = categoryLabels[category!] || category;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${label} - Daily Fun`} description={`浏览${label}分类的搞笑内容`}>
  <section class="mb-8">
    <div class="flex items-center gap-3">
      <a href={`${base}/category`} class="text-sm text-text-secondary no-underline transition-colors hover:text-accent">← 全部分类</a>
      <h1 class="text-2xl font-bold text-text-primary">{label}</h1>
      <span class="rounded-md bg-badge-bg px-2 py-0.5 text-xs text-accent">{page.totalCount} 条</span>
    </div>
  </section>
  <FunFeed items={page.data} />
  <Pagination page={page} />
</BaseLayout>
