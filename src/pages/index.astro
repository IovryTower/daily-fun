---
import BaseLayout from '../layouts/BaseLayout.astro';
import FunFeed from '../components/FunFeed.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { interleaveByDate } from '../utils/interleave';

const allFun = await getCollection('fun');
const sortedFun = allFun.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const interleaved = interleaveByDate(sortedFun);
const PAGE_SIZE = 6;
const pageData = interleaved.slice(0, PAGE_SIZE);
const lastPage = Math.ceil(interleaved.length / PAGE_SIZE);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Daily Fun">
  <section class="mb-8">
    <h1 class="text-2xl font-bold text-text-primary">今日推荐</h1>
    <p class="mt-1 text-sm text-text-secondary">每日搞笑图片、文字、GIF、Meme — 适合摸鱼放松</p>
  </section>
  <a
    href={`${base}/moyu`}
    class="mb-8 flex items-center justify-between gap-4 rounded-xl border border-border bg-surface p-5 transition-shadow hover:shadow-[0_4px_12px_var(--color-card-shadow)]"
  >
    <div>
      <h2 class="text-lg font-bold text-text-primary">🧠 摸鱼猜词</h2>
      <p class="mt-1 text-sm text-text-secondary">输入词语猜隐藏目标词，看关联度% 一路猜中 —— 摸鱼放松新玩法</p>
    </div>
    <span class="shrink-0 text-sm font-medium text-accent">去玩玩 →</span>
  </a>
  <FunFeed items={pageData} />
  {lastPage > 1 && (
    <nav class="mt-8 flex items-center justify-center gap-1" aria-label="分页导航">
      {Array.from({ length: lastPage }, (_, i) => i + 1).map(p => (
        <a
          href={p === 1 ? `${base}/` : `${base}/${p}`}
          class:list={[
            'rounded-md px-3 py-1.5 text-sm transition-colors',
            p === 1
              ? 'bg-accent text-white'
              : 'bg-badge-bg text-text-secondary hover:bg-accent hover:text-white',
          ]}
        >
          {p}
        </a>
      ))}
      <a
        href={`${base}/2`}
        class="rounded-md bg-badge-bg px-3 py-1.5 text-sm text-text-secondary transition-colors hover:bg-accent hover:text-white"
      >
        下一页 →
      </a>
    </nav>
  )}
</BaseLayout>
