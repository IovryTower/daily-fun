---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="摸鱼猜词" description="输入词语猜测隐藏目标词，看关联度直到猜中">
  <section class="mb-6">
    <h1 class="text-2xl font-bold text-text-primary">🧠 摸鱼猜词</h1>
    <p class="mt-1 text-sm text-text-secondary">系统藏了一个词语，输入任意词看它与目标词的关联度，猜中（100%）才算成功</p>
  </section>

  <div id="mode-banner" class="-mt-2 mb-4 flex flex-wrap items-center gap-2 text-sm">
    <span id="mode-daily" class="hidden items-center gap-1.5 rounded-lg bg-badge-bg px-3 py-1 font-semibold text-text-primary"></span>
    <span id="mode-random" class="hidden items-center gap-1.5 rounded-lg bg-badge-bg px-3 py-1 font-semibold text-text-primary"></span>
    <span id="streak-badge" class="hidden items-center gap-1.5 rounded-lg bg-orange-100 px-3 py-1 font-semibold text-orange-600 dark:bg-orange-950/40 dark:text-orange-300"></span>
  </div>

  <div id="game" class="flex flex-col gap-4">
    <!-- 提示卡 -->
    <div class="flex flex-wrap items-center gap-3 rounded-xl border border-border bg-surface p-4">
      <span id="hint-theme" class="rounded-lg bg-badge-bg px-3 py-1 text-sm font-semibold text-text-primary">加载中…</span>
      <span id="hint-length" class="text-sm text-text-secondary"></span>
      <div class="ml-auto flex items-center gap-2">
        <span id="attempt-count" class="text-xs text-text-secondary">第 0 次</span>
        <button id="yesterday-btn" type="button" class="hidden rounded-lg bg-badge-bg px-3 py-1.5 text-sm font-medium text-text-primary transition-colors hover:bg-accent hover:text-white">
          📅 昨日回顾
        </button>
        <button id="back-daily" type="button" class="hidden rounded-lg bg-badge-bg px-3 py-1.5 text-sm font-medium text-text-primary transition-colors hover:bg-accent hover:text-white">
          ↩ 回到今日题
        </button>
        <button id="new-game" type="button" class="rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover">
          🎲 随机一题
        </button>
      </div>
    </div>

    <!-- 输入区 -->
    <form id="guess-form" class="flex gap-2">
      <input
        id="guess-input"
        type="text"
        autocomplete="off"
        placeholder="输入一个词语，如：苹果"
        maxlength="12"
        class="flex-1 rounded-lg border border-border bg-surface px-4 py-2.5 text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none"
      />
      <button type="submit" class="shrink-0 rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover">
        猜！
      </button>
    </form>

    <!-- 结果提示 -->
    <div id="result-bar" class="hidden flex-col gap-1.5 rounded-xl border border-border bg-surface p-4">
      <div class="flex items-baseline justify-between">
        <span id="result-word" class="text-sm font-semibold text-text-primary"></span>
        <span id="result-pct" class="text-2xl font-bold"></span>
      </div>
      <div class="h-2 w-full overflow-hidden rounded-full bg-badge-bg">
        <div id="result-fill" class="h-full rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
      <p id="result-feedback" class="text-xs text-text-secondary"></p>
    </div>

    <!-- 查看答案 -->
    <div class="flex items-center justify-end">
      <button id="reveal-btn" type="button" class="text-xs text-text-secondary transition-colors hover:text-accent">
        😿 猜不出来？看答案
      </button>
    </div>
    <div id="answer-row" class="hidden flex-col gap-2 rounded-xl border border-border bg-surface p-4">
      <div class="flex items-center justify-between">
        <span class="text-sm font-semibold text-text-primary">🔍 查看答案</span>
        <span id="answer-cancel" class="cursor-pointer text-xs text-text-secondary hover:text-text-primary">取消</span>
      </div>
      <p id="answer-desc" class="text-xs text-text-secondary">直接看答案会放弃本局成绩与连击。输入「确认」以继续：</p>
      <div class="flex gap-2">
        <input
          id="answer-input"
          type="text"
          maxlength="4"
          autocomplete="off"
          placeholder="输入：确认"
          class="flex-1 rounded-lg border border-border bg-surface px-3 py-2 text-sm text-text-primary placeholder:text-text-secondary/50 focus:border-accent focus:outline-none"
        />
        <button id="answer-confirm" type="button" class="shrink-0 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover">
          查看
        </button>
      </div>
    </div>
    <div id="reveal-banner" class="hidden flex-col items-center gap-2 rounded-xl border border-orange-400 bg-orange-50 p-4 text-center dark:bg-orange-950/30">
      <p class="text-lg font-bold text-text-primary">答案是「<span id="reveal-word" class="text-accent"></span>」</p>
      <p class="text-xs text-text-secondary">你选择了直接查看，本局不计入成绩与连击 😼</p>
      <button id="reveal-again" type="button" class="rounded-lg bg-badge-bg px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-accent hover:text-white">
        再来一局
      </button>
    </div>

    <!-- 成功横幅 -->
    <div id="success-banner" class="hidden rounded-xl border border-emerald-400 bg-emerald-50 p-4 text-center dark:bg-emerald-950/30">
      <div class="text-4xl">🎉</div>
      <p class="mt-2 text-lg font-bold text-text-primary">猜中啦！目标词就是「<span id="success-word" class="text-accent"></span>」</p>
      <p id="success-attempts" class="mt-1 text-sm text-text-secondary"></p>
      <p id="success-best" class="mt-0.5 text-sm font-semibold text-emerald-600 dark:text-emerald-400"></p>
      <div class="mt-3 flex flex-col items-center gap-2">
        <button id="share-btn" type="button" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-hover">
          📤 复制分享
        </button>
        <span id="share-status" class="text-xs text-text-secondary"></span>
        <div id="share-text" class="mt-1 hidden w-full max-w-xs whitespace-pre-wrap rounded-lg bg-badge-bg p-3 text-left font-mono text-xs text-text-primary"></div>
      </div>
      <button id="again-btn" type="button" class="mt-3 rounded-lg bg-badge-bg px-4 py-2 text-sm font-medium text-text-primary transition-colors hover:bg-accent hover:text-white">
        再来一局
      </button>
    </div>

    <!-- 历史猜测 -->
    <div id="guess-history" class="flex flex-col gap-1.5"></div>

    <!-- 昨日回顾 -->
    <div id="yesterday-panel" class="hidden rounded-xl border border-border bg-surface p-4">
      <div class="flex items-center justify-between gap-2">
        <p id="yesterday-title" class="text-sm font-bold text-text-primary"></p>
        <span id="yesterday-close" class="cursor-pointer text-text-secondary hover:text-text-primary" title="关闭">✕</span>
      </div>
      <div id="yesterday-body" class="mt-3 text-sm text-text-secondary"></div>
    </div>
  </div>
</BaseLayout>

<script>
import { pickTarget, pickDailyTarget, getHint, calcRelation, initCilinIndex } from '../lib/fishGame';

// 异步加载词林语义索引；失败静默回退字符/主题簇算法
(async () => {
  try {
    const resp = await fetch(`${import.meta.env.BASE_URL}data/cilin-index.json`);
    if (resp.ok) {
      const data = await resp.json();
      initCilinIndex(data);
    }
  } catch { /* 离线或失败时用兜底算法 */ }
})();

const state = {
  target: '', attempts: 0, lastPct: -1, mode: 'daily' as 'daily' | 'random',
  pcts: [] as number[],
  entries: [] as { word: string; pct: number; hit: boolean }[],
};
const BEST_KEY = 'moyu-best';
const STREAK_KEY = 'moyu-streak';
const HIST_KEY = 'moyu-daily';

function dateLabel(d = new Date()): string {
  return `${d.getMonth() + 1}月${d.getDate()}日`;
}

function dateKey(d = new Date()): string {
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
}

function yesterdayDate(): Date {
  const d = new Date();
  d.setDate(d.getDate() - 1);
  return d;
}

// ── 连击（每日题连续猜中天数）──
interface StreakSave { last: string; n: number }
function getStreak(): StreakSave {
  try {
    return { last: '', n: 0, ...(JSON.parse(localStorage.getItem(STREAK_KEY) || '{}')) } as StreakSave;
  } catch { return { last: '', n: 0 }; }
}
function recordStreak(): number {
  const today = dateKey();
  const prev = getStreak();
  let n: number;
  if (prev.last === dateKey(yesterdayDate())) {
    n = prev.n + 1;
  } else if (prev.last === today) {
    n = prev.n;
  } else {
    n = 1;
  }
  localStorage.setItem(STREAK_KEY, JSON.stringify({ last: today, n }));
  return n;
}
function refreshStreakBadge() {
  const el = document.getElementById('streak-badge') as HTMLElement;
  const st = getStreak();
  if (state.mode === 'daily' && st.n > 0) {
    el.classList.remove('hidden');
    el.classList.add('flex');
    el.textContent = `🔥 连续猜中 ${st.n} 天`;
  } else {
    el.classList.add('hidden');
    el.classList.remove('flex');
  }
}

// ── 每日成绩历史（昨日回看）──
interface DayRecord { target: string | null; attempts: number; solved: boolean; pcts: number[]; date: string }
function loadDayRecord(key: string): DayRecord | null {
  try {
    const all = JSON.parse(localStorage.getItem(HIST_KEY) || '{}') as Record<string, DayRecord>;
    return all[key] || null;
  } catch { return null; }
}
function saveDayRecord(rec: DayRecord) {
  try {
    const all = JSON.parse(localStorage.getItem(HIST_KEY) || '{}') as Record<string, DayRecord>;
    all[rec.date] = rec;
    // 只保留最近 7 天，避免无限膨胀
    const keys = Object.keys(all).sort().slice(-7);
    for (const k of Object.keys(all)) if (!keys.includes(k)) delete all[k];
    localStorage.setItem(HIST_KEY, JSON.stringify(all));
  } catch { /* ignore */ }
}
function recordDailyGuess(pct: number, hit: boolean, target: string) {
  if (state.mode !== 'daily') return;
  const key = dateKey();
  const rec = loadDayRecord(key) || { date: key, target: null, attempts: 0, solved: false, pcts: [] as number[] };
  rec.attempts = state.attempts;
  if (rec.pcts.length < state.attempts) rec.pcts.push(pct);
  if (hit) { rec.solved = true; rec.target = target; }
  saveDayRecord(rec);
}

function renderYesterday() {
  const panel = document.getElementById('yesterday-panel') as HTMLElement;
  const title = document.getElementById('yesterday-title') as HTMLElement;
  const body = document.getElementById('yesterday-body') as HTMLElement;
  const yKey = dateKey(yesterdayDate());
  const rec = loadDayRecord(yKey);
  title.textContent = `🔙 昨日回顾 · ${dateLabel(yesterdayDate())}`;
  if (!rec || rec.pcts.length === 0) {
    body.innerHTML = '<p class="opacity-70">昨天没有玩哦，今天来一局吧～</p>';
  } else {
    let rows = '';
    let line = '';
    for (const p of rec.pcts) {
      line += emojiFor(p);
      if (line.length === 10) { rows += `<div>${line}</div>`; line = ''; }
    }
    if (line) rows += `<div>${line}</div>`;
    const result = rec.solved
      ? `✅ 猜中了！目标词是「<b class="text-accent">${rec.target}</b>」，用了 ${rec.attempts} 次`
      : `❌ 没猜中，一共猜了 ${rec.attempts} 次`;
    body.innerHTML = `
      <div class="mb-2 font-mono text-xs leading-relaxed">${rows || '<span class="opacity-50">（无猜测记录）</span>'}</div>
      <p>${result}</p>`;
  }
  panel.classList.remove('hidden');
  panel.classList.add('flex');
  panel.classList.add('flex-col');
  panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function emojiFor(pct: number): string {
  if (pct >= 88) return '🟩';
  if (pct >= 65) return '🟨';
  if (pct >= 35) return '🟧';
  if (pct > 0) return '🟥';
  return '⬛';
}

function colorFor(pct: number): string {
  if (pct >= 88) return '#10B981';   // 绿
  if (pct >= 65) return '#84CC16';   // 黄绿
  if (pct >= 35) return '#F59E0B';   // 橙
  return '#EF4444';                  // 红
}

function getBest(): number {
  return parseInt(localStorage.getItem(BEST_KEY) || '0', 10) || 0;
}

function startGame(mode: 'daily' | 'random') {
  state.mode = mode;
  state.target = mode === 'daily' ? pickDailyTarget(new Date()) : pickTarget();
  state.attempts = 0;
  state.lastPct = -1;
  state.pcts = [];

  const dailyEl = document.getElementById('mode-daily') as HTMLElement;
  const randomEl = document.getElementById('mode-random') as HTMLElement;
  dailyEl.classList.toggle('hidden', mode !== 'daily');
  dailyEl.classList.toggle('flex', mode === 'daily');
  dailyEl.textContent = `📅 今日题 · ${dateLabel()}`;
  randomEl.classList.toggle('hidden', mode !== 'random');
  randomEl.classList.toggle('flex', mode === 'random');
  randomEl.textContent = '🎲 随机练习';
  (document.getElementById('back-daily') as HTMLElement).classList.toggle('hidden', mode !== 'random');
  (document.getElementById('yesterday-btn') as HTMLElement).classList.toggle('hidden', mode !== 'daily');
  (document.getElementById('yesterday-panel') as HTMLElement).classList.add('hidden');
  refreshStreakBadge();

  const hint = getHint(state.target);
  (document.getElementById('hint-theme') as HTMLElement).textContent =
    `${hint.emoji} 目标属于「${hint.themeName}」`;
  (document.getElementById('hint-length') as HTMLElement).textContent =
    `这是一个 ${hint.length} 字词语`;
  (document.getElementById('attempt-count') as HTMLElement).textContent = '第 0 次';
  (document.getElementById('success-banner') as HTMLElement).classList.add('hidden');
  (document.getElementById('result-bar') as HTMLElement).classList.add('hidden');
  (document.getElementById('share-text') as HTMLElement).classList.add('hidden');
  (document.getElementById('share-status') as HTMLElement).textContent = '';
  (document.getElementById('guess-history') as HTMLElement).innerHTML = '';
  state.entries = [];
  (document.getElementById('reveal-banner') as HTMLElement).classList.add('hidden');
  (document.getElementById('answer-row') as HTMLElement).classList.add('hidden');
  (document.getElementById('answer-input') as HTMLInputElement).value = '';
  (document.getElementById('answer-desc') as HTMLElement).textContent = '直接看答案会放弃本局成绩与连击。输入「确认」以继续：';
  const input = document.getElementById('guess-input') as HTMLInputElement;
  input.value = '';
  input.disabled = false;
  input.focus();
}

function buildShareText(): string {
  const modeLine = state.mode === 'daily' ? `每日一题 · ${dateLabel()}` : '随机练习';
  const rows: string[] = [];
  let line = '';
  for (const p of state.pcts) {
    line += emojiFor(p);
    if (line.length === 10) { rows.push(line); line = ''; }
  }
  if (line) rows.push(line);
  const streak = getStreak().n;
  const streakLine = state.mode === 'daily' && streak > 0 ? `🔥 连击 ${streak} 天` : '';
  return `🧠 摸鱼猜词 ${modeLine} · ${state.attempts} 次
${rows.join('\n')}
${streakLine ? streakLine + '\n' : ''}🟩≥88 🟨≥65 🟧≥35 🟥<35 ⬛0
https://daily-fun.pages.dev/moyu`;
}

function showShare() {
  const text = buildShareText();
  const box = document.getElementById('share-text') as HTMLElement;
  box.textContent = text;
  box.classList.remove('hidden');
  const status = document.getElementById('share-status') as HTMLElement;
  if (navigator.clipboard?.writeText) {
    navigator.clipboard.writeText(text).then(() => {
      status.textContent = '✓ 已复制到剪贴板';
    }).catch(() => {
      status.textContent = '复制失败，可直接选中下方文本复制';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  } else {
    status.textContent = '可直接选中下方文本复制';
    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
}

// 历史列表：按关联度降序渲染，最高概率排最前（命中 100% 置顶）
function renderHistory() {
  const history = document.getElementById('guess-history') as HTMLElement;
  history.innerHTML = '';
  const sorted = [...state.entries].sort((a, b) => b.pct - a.pct);
  for (const e of sorted) {
    const row = document.createElement('div');
    row.className = 'flex items-center gap-3 rounded-lg border border-border bg-surface px-3 py-2';
    row.innerHTML = `
      <span class="w-24 shrink-0 truncate text-sm font-medium text-text-primary"></span>
      <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-badge-bg">
        <div class="h-full" style="width:${e.pct}%;background:${colorFor(e.pct)}"></div>
      </div>
      <span class="w-12 shrink-0 text-right text-xs font-semibold" style="color:${colorFor(e.pct)}"></span>
    `;
    row.querySelector('span')!.textContent = e.word;
    row.querySelector('.w-12')!.textContent = `${e.pct.toFixed(1)}%`;
    history.appendChild(row);
  }
}

function submitGuess(word: string) {
  state.attempts++;
  const pct = calcRelation(word, state.target);
  const hit = pct >= 100;
  state.pcts.push(pct);
  (document.getElementById('attempt-count') as HTMLElement).textContent = `第 ${state.attempts} 次`;

  const bar = document.getElementById('result-bar') as HTMLElement;
  bar.classList.remove('hidden');
  bar.classList.add('flex');
  (document.getElementById('result-word') as HTMLElement).textContent = word;
  (document.getElementById('result-pct') as HTMLElement).textContent = `${pct.toFixed(1)}%`;
  (document.getElementById('result-pct') as HTMLElement).style.color = colorFor(pct);
  const fill = document.getElementById('result-fill') as HTMLElement;
  fill.style.width = `${pct}%`;
  fill.style.background = colorFor(pct);

  const feedback = document.getElementById('result-feedback') as HTMLElement;
  if (hit) {
    feedback.textContent = '💯 完美命中！';
  } else if (state.lastPct >= 0) {
    feedback.textContent = pct > state.lastPct ? '↑ 比上一次更接近目标了' : '↓ 比上一次更远了';
  } else {
    feedback.textContent = '再试试其他词语';
  }
  state.lastPct = pct;
    recordDailyGuess(pct, hit, state.target);

  // 历史列表：按关联度降序
  state.entries.push({ word, pct, hit });
  renderHistory();

  if (hit) {
    const banner = document.getElementById('success-banner') as HTMLElement;
    (document.getElementById('success-word') as HTMLElement).textContent = state.target;
    (document.getElementById('success-attempts') as HTMLElement).textContent = `用了 ${state.attempts} 次猜中`;
    const best = getBest();
    if (best === 0 || state.attempts < best) {
      localStorage.setItem(BEST_KEY, String(state.attempts));
      (document.getElementById('success-best') as HTMLElement).textContent = '🏆 新纪录！';
    } else {
      (document.getElementById('success-best') as HTMLElement).textContent = `🏆 最佳纪录 ${best} 次`;
    }
    banner.classList.remove('hidden');
    (document.getElementById('guess-input') as HTMLInputElement).disabled = true;
    if (state.mode === 'daily') {
      recordStreak();
      refreshStreakBadge();
    }
  }
}

document.getElementById('guess-form')!.addEventListener('submit', (e) => {
  e.preventDefault();
  const input = document.getElementById('guess-input') as HTMLInputElement;
  const word = input.value.trim();
  if (word) submitGuess(word);
  input.value = '';
});

document.getElementById('share-btn')!.addEventListener('click', showShare);
document.getElementById('new-game')!.addEventListener('click', () => startGame('random'));
document.getElementById('back-daily')!.addEventListener('click', () => startGame('daily'));
document.getElementById('again-btn')!.addEventListener('click', () => startGame(state.mode));
document.getElementById('yesterday-btn')!.addEventListener('click', renderYesterday);
document.getElementById('yesterday-close')!.addEventListener('click', () => {
  (document.getElementById('yesterday-panel') as HTMLElement).classList.add('hidden');
});

// ── 查看答案：需输入「确认」才显示，本局不计成绩/连击 ──
document.getElementById('reveal-btn')!.addEventListener('click', () => {
  const row = document.getElementById('answer-row') as HTMLElement;
  if (row.classList.contains('hidden')) {
    row.classList.remove('hidden');
    row.classList.add('flex');
    (document.getElementById('answer-input') as HTMLInputElement).focus();
  } else {
    row.classList.add('hidden');
  }
});
document.getElementById('answer-cancel')!.addEventListener('click', () => {
  (document.getElementById('answer-row') as HTMLElement).classList.add('hidden');
  (document.getElementById('answer-input') as HTMLInputElement).value = '';
});
document.getElementById('answer-confirm')!.addEventListener('click', () => {
  const inp = document.getElementById('answer-input') as HTMLInputElement;
  if (inp.value.trim() !== '确认') {
    (document.getElementById('answer-desc') as HTMLElement).textContent = '请输入「确认」两个字才能查看答案，还想自己再努力一下吗？';
    return;
  }
  (document.getElementById('answer-row') as HTMLElement).classList.add('hidden');
  (document.getElementById('reveal-word') as HTMLElement).textContent = state.target;
  (document.getElementById('reveal-banner') as HTMLElement).classList.remove('hidden');
  (document.getElementById('reveal-banner') as HTMLElement).classList.add('flex');
  (document.getElementById('guess-input') as HTMLInputElement).disabled = true;
});
document.getElementById('reveal-again')!.addEventListener('click', () => startGame(state.mode));

startGame('daily');
</script>