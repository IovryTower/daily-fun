---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面未找到">
  <div class="py-20 text-center">
    <div class="mb-4 text-6xl">😵</div>
    <h1 class="mb-2 text-3xl font-bold text-text-primary">404</h1>
    <p class="mb-6 text-text-secondary">这个页面好像跑丢了...</p>
    <a href="/" class="inline-block rounded-lg bg-accent px-5 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-accent-hover">
      回到首页
    </a>
  </div>
</BaseLayout>
