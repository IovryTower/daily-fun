---
import FunCard from './FunCard.astro';

interface FunItem {
  data: {
    title: string;
    date: Date;
    category: string;
    tags: string[];
    image?: string;
    imageAlt?: string;
    description?: string;
  };
  body: any;
  id: string;
}

interface Props {
  items: FunItem[];
}

const { items } = Astro.props;

function extractText(body: any): string {
  if (!body) return '';
  const raw = typeof body === 'string' ? body : String(body);
  return raw.replace(/<[^>]*>/g, '').trim();
}
---

<div class="flex flex-col gap-6">
  {items.map((item) => (
    <FunCard
      itemId={item.id}
      title={item.data.title}
      date={item.data.date}
      category={item.data.category}
      tags={item.data.tags}
      image={item.data.image}
      imageAlt={item.data.imageAlt}
      description={item.data.description || extractText(item.body)}
    />
  ))}
</div>
