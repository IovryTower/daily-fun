---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{tags.length > 0 && (
  <div class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <a
        href={`${base}/tag/${encodeURIComponent(tag)}`}
        class="text-xs text-text-secondary no-underline transition-colors hover:text-accent"
      >
        #{tag}
      </a>
    ))}
  </div>
)}
