---
const currentYear = new Date().getFullYear();
const buildTime = new Date().toLocaleString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Asia/Shanghai',
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t border-border py-8 text-center text-sm text-text-secondary">
  <div class="mx-auto max-w-3xl px-4">
    <p>&copy; {currentYear} Daily Fun · <a href={`${base}/rss.xml`} class="text-accent underline hover:text-accent-hover">RSS</a></p>
    <p class="mt-2 flex items-center justify-center gap-2">
      <span>版本: {buildTime}</span>
      <button
        id="refresh-btn"
        type="button"
        class="rounded-md bg-badge-bg px-2 py-0.5 text-xs text-accent transition-colors hover:bg-accent hover:text-white"
      >
        刷新
      </button>
      <a href={`${base}/admin`} class="text-xs text-text-secondary/50 transition-colors hover:text-accent" title="内容管理">管理</a>
    </p>
  </div>
</footer>

<script>
  const btn = document.getElementById('refresh-btn');
  btn?.addEventListener('click', () => {
    location.reload();
  });
</script>
