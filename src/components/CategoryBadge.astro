---
interface Props {
  category: string;
}

const { category } = Astro.props;

const categoryMeta: Record<string, { label: string; icon: string }> = {
  meme:  { label: '梗图', icon: '😂' },
  joke:  { label: '笑话', icon: '🤣' },
  quote: { label: '趣句', icon: '✨' },
  gif:   { label: '动图', icon: '🎬' },
  image: { label: '趣图', icon: '🖼️' },
  other: { label: '其他', icon: '🎲' },
};

const meta = categoryMeta[category] || { label: category, icon: '📁' };
---

<span class="inline-flex items-center gap-1 rounded-md bg-badge-bg px-2 py-0.5 text-xs font-medium text-accent">
  <span>{meta.icon}</span>
  <span>{meta.label}</span>
</span>
