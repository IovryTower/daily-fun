---
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/`, label: '首页' },
  { href: `${base}/latest`, label: '最新' },
  { href: `${base}/category`, label: '分类' },
  { href: `${base}/about`, label: '关于' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a href={`${base}/`} class="text-xl font-bold text-text-primary no-underline transition-colors hover:text-accent">
      Daily Fun
    </a>
    <nav class="flex items-center gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary no-underline transition-colors hover:text-accent"
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle />
    </nav>
  </div>
</header>
