{
  "name": "daily-fun",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "astro build",
    "build:cf": "CF_PAGES=1 astro build",
    "deploy:cf": "CF_PAGES=1 astro build && wrangler pages deploy dist --project-name daily-fun",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "lighthouse": "^13.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.118.0"
  }
}
